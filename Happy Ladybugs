string happyLadybugs(string b) {
    int freq[26] = {0};
    int n = b.size();
    bool hasEmpty = false;

    for (char c : b) {
        if (c == '_') {
            hasEmpty = true;
        } else {
            freq[c - 'A']++;
        }
    }

    for (int i = 0; i < 26; i++) {
        if (freq[i] == 1) return "NO";
    }

    if (!hasEmpty) {
        for (int i = 0; i < n; i++) {
            if ((i > 0 && b[i] == b[i-1]) || (i < n-1 && b[i] == b[i+1])) continue;
            else return "NO";
        }
    }

    return "YES";
}

