#include <iostream>
#include <vector>
#include <numeric>

using namespace std;

// Complete the birthday function below.
int birthday(vector<int> s, int d, int m) {
    int count = 0;
    int current_sum = 0;
    
    // Cast m to size_t to fix the compiler signedness warning
    if (s.size() < static_cast<size_t>(m)) return 0;

    // Calculate the sum of the first window of size m
    for (int i = 0; i < m; i++) {
        current_sum += s[i];
    }

    // Check the first window
    if (current_sum == d) {
        count++;
    }

    // Slide the window across the rest of the array
    for (size_t i = m; i < s.size(); i++) {
        current_sum += s[i] - s[i - m]; // Add new element, remove oldest element
        if (current_sum == d) {
            count++;
        }
    }

    return count;
}

int main() {
    int n;
    if (!(cin >> n)) return 0;
    
    vector<int> s(n);
    for (int i = 0; i < n; i++) {
        cin >> s[i];
    }
    
    int d;
    int m;
    cin >> d >> m;
    
    int result = birthday(s, d, m);
    
    cout << result << endl;
    
    return 0;
}
