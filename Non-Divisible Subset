#include <bits/stdc++.h>
using namespace std;

int nonDivisibleSubset(int k, vector<int> S) {
    vector<int> freq(k, 0);

    for (int num : S) {
        freq[num % k]++;
    }

    int ans = 0;

    if (freq[0] > 0) {
        ans++;
    }

    for (int i = 1; i <= k / 2; i++) {

        if (i == k - i) {
            if (freq[i] > 0) {
                ans++;
            }
        }
        else {
            ans += max(freq[i], freq[k - i]);
        }
    }

    return ans;
}

int main() {
    int n, k;
    cin >> n >> k;

    vector<int> S(n);

    for (int i = 0; i < n; i++) {
        cin >> S[i];
    }

    cout << nonDivisibleSubset(k, S);

    return 0;
}
