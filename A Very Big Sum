#include <bits/stdc++.h>
using namespace std;

long long aVeryBigSum(vector<long long> arr) {
    long long sum = 0;

    for (long long x : arr) {
        sum += x;
    }

    return sum;
}

int main() {
    int n;
    cin >> n;

    vector<long long> arr(n);

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << aVeryBigSum(arr);

    return 0;
}
