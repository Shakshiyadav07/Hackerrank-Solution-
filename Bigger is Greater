#include <bits/stdc++.h>
using namespace std;

string biggerIsGreater(string w) {
    int n = w.size();
    int i = n - 2;

    // Step 1: find pivot
    while (i >= 0 && w[i] >= w[i + 1]) i--;
    if (i < 0) return "no answer";

    // Step 2: find next greater element
    int j = n - 1;
    while (w[j] <= w[i]) j--;

    // Step 3: swap
    swap(w[i], w[j]);

    // Step 4: reverse suffix
    reverse(w.begin() + i + 1, w.end());

    return w;
}

int main() {
    int T;
    cin >> T;
    while (T--) {
        string w;
        cin >> w;
        cout << biggerIsGreater(w) << "\n";
    }
    return 0;
}
