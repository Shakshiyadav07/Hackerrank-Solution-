#include <bits/stdc++.h>
using namespace std;

long long gridlandMetro(long long n, long long m, int k, vector<vector<long long>> track) {
    unordered_map<long long, vector<pair<long long, long long>>> rows;

    // Step 1: Group by row
    for (auto &t : track) {
        rows[t[0]].push_back({t[1], t[2]});
    }

    long long covered = 0;

    // Step 2: Merge intervals in each row
    for (auto &row : rows) {
        auto &intervals = row.second;
        sort(intervals.begin(), intervals.end());

        long long start = intervals[0].first;
        long long end = intervals[0].second;

        for (size_t i = 1; i < intervals.size(); ++i) {
            if (intervals[i].first <= end) {
                // Overlapping interval, extend
                end = max(end, intervals[i].second);
            } else {
                // No overlap, count previous
                covered += (end - start + 1);
                start = intervals[i].first;
                end = intervals[i].second;
            }
        }
        covered += (end - start + 1);
    }

    // Step 3: Empty cells = total - covered
    long long total = n * m;
    return total - covered;
}

int main() {
    long long n, m;
    int k;
    cin >> n >> m >> k;

    vector<vector<long long>> track(k, vector<long long>(3));
    for (int i = 0; i < k; i++)
        cin >> track[i][0] >> track[i][1] >> track[i][2];

    cout << gridlandMetro(n, m, k, track) << endl;
    return 0;
}
